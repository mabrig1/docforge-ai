# ── MongoDB ────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/marketplace?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRES_IN=7d

# ── Cloudflare R2 ──────────────────────────────────────────────
# Account ID visible in the R2 dashboard URL
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2 Access Key ID  (Settings → R2 API Tokens)
R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Bucket name in Cloudflare R2
R2_BUCKET_NAME=docforge-products
# Pre-signed URL lifetime in seconds (default: 15 minutes)
R2_URL_EXPIRES=900

# ── Flutterwave ────────────────────────────────────────────────
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_ENCRYPTION_KEY=your_flutterwave_encryption_key
# Must exactly match the URL configured in Flutterwave dashboard
FLW_WEBHOOK_SECRET=your_flw_webhook_secret

# ── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000,https://creators.fintigen.com
# Full URL of the Next.js frontend (used in payment redirect_url and email links)
FRONTEND_URL=https://creators.fintigen.com

# ── Auth mode ──────────────────────────────────────────────────
# bearer (default) — JWT in Authorization header, stored in localStorage
# cookie           — JWT in httpOnly Secure SameSite=Strict cookie (XSS hardened)
#                    Requires HTTPS in production and credentials:true CORS
AUTH_MODE=bearer

# ── Email receipts (Resend) ────────────────────────────────────
# Sign up free at https://resend.com — 3,000 emails/month on free tier
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=receipts@creators.fintigen.com
