# ── DocForge AI — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# Lines beginning with # are comments and are ignored.

# ── Required ─────────────────────────────────────────────────────────────────

# Your Anthropic API key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Secret key used to sign JWTs — MUST be set to a fixed value in production.
# If left unset the server generates a random key on each restart, which
# invalidates all existing tokens on every restart.
# Generate a good key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string

# ── Admin Account ────────────────────────────────────────────────────────────

# Credentials for the seeded admin account (created on first run if missing).
# CHANGE THESE before first deployment.
ADMIN_EMAIL=admin@docforge.ai
ADMIN_PASSWORD=Admin@DocForge2024
ADMIN_NAME=Administrator

# ── Optional — AI Model ──────────────────────────────────────────────────────

# Anthropic model to use for all AI calls.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Optional — Server ────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Optional — Auth ──────────────────────────────────────────────────────────

# JWT lifetime in minutes (default 1440 = 24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Optional — Database ──────────────────────────────────────────────────────

# Path for the SQLite database file.
# On Render, point this to a persistent disk: /data/docforge.db
# DATABASE_URL=./docforge.db
